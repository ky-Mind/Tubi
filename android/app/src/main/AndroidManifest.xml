<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Aplikasi e-wallet & bank yang bisa dibuka dari halaman pembayaran (lihat www/js/pay.js) -->
    <queries>
        <package android:name="com.gojek.gopay" />
        <package android:name="ovo.id" />
        <package android:name="id.dana" />
        <package android:name="com.shopeepay.id" />
        <package android:name="com.telkom.mwallet" />
        <package android:name="com.ada.astrapay" />
        <package android:name="com.isaku.app" />
        <package android:name="com.bca" />
        <package android:name="id.bmri.livin" />
        <package android:name="id.co.bri.brimo" />
        <package android:name="id.bni.wondr" />
        <package android:name="com.bsm.activity2" />
        <package android:name="id.co.cimbniaga.mobile.android" />
        <package android:name="net.myinfosys.PermataMobileX" />
        <package android:name="com.dbank.mobile" />
        <package android:name="id.com.uiux.mobile" />
        <package android:name="id.co.bankbkemobile.digitalbank" />
        <package android:name="com.jago.digitalBanking" />
        <package android:name="com.bcadigital.blu" />
        <package android:name="com.alloapp.yump" />
        <package android:name="com.btpn.dc" />
        <package android:name="id.co.linebank" />
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
            <!-- Push Tubi: layanan sendiri (data-only, selalu jalan walau aplikasi mati) menggantikan layanan bawaan plugin -->
        <service android:name="com.capacitorjs.plugins.pushnotifications.MessagingService" tools:node="remove" />
        <service android:name=".TubiPesan" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="tubi-pesanan" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_tubi" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/tubi_merah" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notifikasi pesanan & chat (Android 13+ minta izin) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Titik lokasi pengantaran (tombol GPS di checkout & profil) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Kamera untuk foto bukti transfer, chat, dan foto produk -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Memasang pembaruan Tubi langsung dari dalam aplikasi -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Printer thermal Bluetooth (struk) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Agar notifikasi tetap masuk saat HP hemat daya -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
</manifest>
